# LedGio Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# ===================================================================
# DJANGO CORE
# ===================================================================
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===================================================================
# EMAIL — Development (Console Backend)
# Emails print to your terminal. No SMTP needed.
# ===================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ===================================================================
# EMAIL — Gmail SMTP (switch to this for real email delivery)
# 1. Go to Google Account → Security → App Passwords
# 2. Generate an App Password for "Mail"
# 3. Paste it below (NOT your regular Google password)
# ===================================================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-gmail@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=LedGio <your-gmail@gmail.com>

# ===================================================================
# EMAIL — SendGrid (production-grade, uncomment to use)
# pip install django-anymail[sendgrid]
# ===================================================================
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# ===================================================================
# EMAIL — Mailgun (uncomment to use)
# pip install django-anymail[mailgun]
# ===================================================================
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
# MAILGUN_API_KEY=key-your-mailgun-api-key
# MAILGUN_SENDER_DOMAIN=mg.yourdomain.com

# ===================================================================
# GOOGLE OAUTH2
# Get these from Google Cloud Console (instructions below)
# ===================================================================
GOOGLE_CLIENT_ID=xxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxx

# ===================================================================
# EMAIL VERIFICATION
# Set to "mandatory" in production, "none" during dev if needed
# ===================================================================
ACCOUNT_EMAIL_VERIFICATION=mandatory
