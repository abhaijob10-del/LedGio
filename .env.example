# LedGio Production Environment Configuration Example
# Copy this file to .env and set your production values.
# NEVER commit .env to git repository.

# ===================================================================
# DJANGO CORE
# ===================================================================
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-in-production
DJANGO_DEBUG=False
# Replace with your actual BigRock/cPanel subdomain or domain, e.g.:
#   DJANGO_ALLOWED_HOSTS=ledgio.yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Must match your HTTPS domain exactly:
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===================================================================
# EMAIL CONFIGURATION (SMTP)
# ===================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=LedGio <your-email@gmail.com>
SERVER_EMAIL=LedGio Admin <your-email@gmail.com>

# ===================================================================
# GOOGLE OAUTH2 CREDENTIALS
# ===================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===================================================================
# EMAIL VERIFICATION
# ===================================================================
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ===================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===================================================================
DB_NAME=ledgio_db
DB_USER=postgres
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ===================================================================
# PRODUCTION SECURITY OPTIONS
# ===================================================================
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Set to False if SSL is terminated at the cPanel/proxy level (most BigRock shared hosting).
# Set to True only if Django itself receives the HTTPS connection directly.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ===================================================================
# MEDIA FILES
# ===================================================================
# On BigRock cPanel hosting, /media/ is served directly by Apache/cPanel
# pointing to the MEDIA_ROOT directory. No nginx or S3 required.
# Ensure your cPanel File Manager or Passenger config maps /media/ to the
# media/ folder inside your Django project root.
# MEDIA_URL=/media/
# MEDIA_ROOT is set automatically in settings.py to <project_root>/media/
